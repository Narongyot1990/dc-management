  "yc_checklist_item_4_desc": "Check floor, walls, ceiling, door interior for stains or leftover debris.",
  "yc_checklist_item_4_ng": "NG: oil/grease/chemical stains, wood/glass scraps, insects or animal droppings.",
  "yc_checklist_item_5": "Exterior condition & container no.",
